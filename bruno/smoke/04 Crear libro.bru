meta {
  name: Crear libro
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "title": "Cien años de soledad",
    "author": "Gabriel García Márquez",
    "year": 1967,
    "copies": 2
  }
}

assert {
  res.status: eq 201
  res.headers.location: isDefined
}

tests {
  test("Devuelve 201 con Location y el libro creado", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("location")).to.include("/books/");
    expect(res.body.title).to.equal("Cien años de soledad");
  });

  const id = res.body && res.body.id !== undefined
    ? res.body.id
    : String(res.getHeader("location")).split("/").pop();
  bru.setVar("smokeId", id);
}

