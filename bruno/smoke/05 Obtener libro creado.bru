meta {
  name: Obtener libro creado
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/books/{{smokeId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("El libro creado se puede leer", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.author).to.equal("Gabriel García Márquez");
    expect(res.body.year).to.equal(1967);
  });
}

