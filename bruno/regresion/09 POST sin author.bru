meta {
  name: POST sin author
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "title": "Libro de prueba",
    "year": 2000
  }
}

assert {
  res.status: eq 422
}

tests {
  // Técnica ISTQB: Partición de Equivalencia - clase inválida: falta el campo obligatorio author

  test("Rechaza un libro sin author con 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
}

docs {
  Técnica ISTQB: Partición de Equivalencia - clase inválida: falta un campo obligatorio (author).
}
