meta {
  name: POST sin copies usa valor por defecto
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "title": "Ficciones",
    "author": "Jorge Luis Borges",
    "year": 1944
  }
}

assert {
  res.status: eq 201
}

tests {
  // Técnica ISTQB: Partición de Equivalencia - clase válida: campo opcional copies omitido

  test("copies vale 1 por defecto", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.copies).to.equal(1);
  });
}

docs {
  Técnica ISTQB: Partición de Equivalencia - clase válida 'copies omitido' (debe valer 1 por defecto).
}
