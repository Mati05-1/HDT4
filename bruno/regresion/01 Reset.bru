meta {
  name: Reset
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reset
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{apiKey}}
}

assert {
  res.status: eq 200
}

tests {
  test("El estado vuelve a los 3 libros iniciales", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

