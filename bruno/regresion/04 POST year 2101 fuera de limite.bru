meta {
  name: POST year 2101 fuera de limite
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "title": "Libro de prueba",
    "author": "Autor Prueba",
    "year": 2101
  }
}

assert {
  res.status: eq 422
}

tests {
  // Técnica ISTQB: Análisis de Valores Límite (BVA) - year = 2101 (justo encima del máximo, inválido)

  test("Rechaza year = 2101 con 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
}

docs {
  Técnica ISTQB: Análisis de Valores Límite (BVA) - year = 2101, justo por encima del máximo.
}
