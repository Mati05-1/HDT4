meta {
  name: POST copies 1000 fuera de limite
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "title": "Libro de prueba",
    "author": "Autor Prueba",
    "year": 2000,
    "copies": 1000
  }
}

assert {
  res.status: eq 422
}

tests {
  // Técnica ISTQB: Análisis de Valores Límite (BVA) - copies = 1000 (inválido)

  test("Rechaza copies = 1000 con 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
}

docs {
  Técnica ISTQB: Análisis de Valores Límite (BVA) - copies = 1000, justo sobre el máximo 999.
}
