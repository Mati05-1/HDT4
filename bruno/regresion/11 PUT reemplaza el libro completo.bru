meta {
  name: PUT reemplaza el libro completo
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/books/{{bookId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "title": "El Aleph",
    "author": "Jorge Luis Borges",
    "year": 2100,
    "copies": 999
  }
}

assert {
  res.status: eq 200
}

tests {
  // Técnica ISTQB: Análisis de Valores Límite (BVA) - year = 2100 y copies = 999 (máximos válidos)

  test("PUT reemplaza todos los campos", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.title).to.equal("El Aleph");
    expect(res.body.author).to.equal("Jorge Luis Borges");
    expect(res.body.year).to.equal(2100);
    expect(res.body.copies).to.equal(999);
  });
}

docs {
  Técnica ISTQB: Análisis de Valores Límite (BVA) - year = 2100 y copies = 999 (máximos válidos) en un PUT.
}
